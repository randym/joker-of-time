# Recorder page URL. All automations start here (login check, then clock or timecard).
# Production: your King of Time recorder URL.
# Local mock: http://localhost:4301/  (with yarn mock running on port 4301)
KOT_BASE_URL=https://s3.ta.kingoftime.jp/independent/recorder2/personal/

# App UI language for dev builds only (e.g. yarn start). "en" or "ja". Production builds ignore this and use OS locale (fallback en).
# LOCALE=ja

# Run browser headless (default: true). Set to "false" to show the browser during automation.
# KOT_HEADLESS=false

# Enable dev logging: CLI logs to stderr and logs/clocker.log (default: off).
# JOT_DEV=1

# Extra debug logs when JOT_DEV=1 (default: off).
# DEBUG=1

# Mock server port for yarn mock (default: 4301). Only used by scripts/serve-mock.js.
# MOCK_PORT=4301